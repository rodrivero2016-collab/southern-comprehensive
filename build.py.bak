# -*- coding: utf-8 -*-
"""Static site generator for Southern Comprehensive Insurance, LLC."""
import os, io

OUT = os.path.dirname(os.path.abspath(__file__))

PHONE_TXT = '<span class="ph">[PHONE]</span>'
EMAIL_TXT = '<span class="ph">[EMAIL]</span>'
ADDR_TXT  = '<span class="ph">[STREET ADDRESS, CITY, GA ZIP]</span>'
LIC_TXT   = '<span class="ph">[GA LICENSE #]</span>'

def T(s):
    return (s.replace("{{PHONE}}", PHONE_TXT)
             .replace("{{EMAIL}}", EMAIL_TXT)
             .replace("{{ADDR}}", ADDR_TXT)
             .replace("{{LIC}}", LIC_TXT))


NAV = [
    ("index.html", "Home"),
    ("medicare.html", "Medicare"),
    ("health.html", "Health"),
    ("life.html", "Life"),
    ("supplemental.html", "Supplemental"),
    ("resources.html", "Resources"),
    ("blog.html", "Blog"),
    ("about.html", "About"),
    ("reviews.html", "Reviews"),
]

def header():
    links = "\n".join(
        '      <a href="%s">%s</a>' % (h, t) for h, t in NAV
