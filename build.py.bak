def page(filename, title, description, body, extra_head=""):
    html = """<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>%s | Southern Comprehensive Insurance, LLC</title>
<meta name="description" content="%s">
<meta name="robots" content="index, follow">
<meta property="og:title" content="%s | Southern Comprehensive Insurance, LLC">
<meta property="og:description" content="%s">
<meta property="og:type" content="website">
<meta property="og:image" content="assets/img/logo.png">
<meta name="theme-color" content="#032454">
<link rel="icon" href="assets/img/logo.png">
<link rel="stylesheet" href="assets/css/styles.css">
%s
</head>
<body>
%s
<main id="main">
%s
</main>
%s
</body>
</html>
""" % (title, description, title, description, extra_head, header(), body, footer())
    with io.open(os.path.join(OUT, filename), "w", encoding="utf-8") as f:
        f.write(html)
    print("wrote", filename, len(html), "bytes")


def pagehead(eyebrow, h1, sub):
    return """
<section class="pagehead">
  <div class="wrap">
    <p class="eyebrow">%s</p>
    <h1>%s</h1>
    <p>%s</p>
  </div>
</section>
""" % (eyebrow, h1, sub)

